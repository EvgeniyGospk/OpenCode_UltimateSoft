# Console API
CONSOLE_API_HOST=127.0.0.1
CONSOLE_API_PORT=4310

# Console UI
VITE_CONSOLE_API_BASE_URL=http://127.0.0.1:4310
# Port for the Vite dev server (must match VITE_PORT used by start-console.sh)
VITE_PORT=5174

# Vite file watcher (useful in Docker / WSL / VMs where inotify is unavailable)
# Set VITE_USE_POLLING=1 to switch from inotify to polling
VITE_USE_POLLING=
# Polling interval in milliseconds (only used when VITE_USE_POLLING is set)
VITE_POLL_INTERVAL=300

# Job worker — OpenCode server connection
# The worker talks to the running OpenCode server's HTTP API.
# These are auto-detected by start-console.sh from the running opencode instance.
# If not set, job execution will fail with a clear error.
# OPENCODE_SERVER_URL=http://127.0.0.1:33241
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=
# Maximum time (ms) a single smoke job may run before the worker kills it (default: 120000)
SMOKE_TIMEOUT_MS=120000

# Legacy migration (optional)
OC_LEGACY_USER_HOME=/Users/guard2

# Profile paths (optional — leave commented out to use defaults)
# WARNING: Do NOT set these to empty values (e.g. OC_PROFILE=) —
# an empty string resolves to the working directory instead of ~/.config/opencode.
# OC_PROFILE=~/.config/opencode
# OPENCODE_PROFILE_DIR=
# OC_SNAPSHOTS_ROOT=
