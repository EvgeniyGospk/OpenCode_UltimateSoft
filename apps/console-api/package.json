{
  "name": "@opencode-console/console-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "sync:agents": "tsx src/scripts/sync-agent-registry.ts",
