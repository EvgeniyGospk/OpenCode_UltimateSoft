{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedParameters": true,
    // "noUnusedLocals": true — skipped: src/ files have unused locals that are out of scope for this round
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@opencode-console/api-client-generated": [
        "../../packages/api-client-generated/src/index.ts"
      ]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
