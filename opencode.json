  "permission": {
    "delegate_task": "allow",
    "task": {
      "*": "allow"
    },
    "skill": {
      "git-master": "allow",
      "*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "agent": {
    "build": {
      "model": "anthropic/claude-sonnet-4-6",
