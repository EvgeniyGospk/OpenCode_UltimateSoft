      "description": "Search-focused subagent on GPT 5.3 Codex (OAuth).",
      "model": "openai/gpt-5.3-codex",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "webfetch": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "task": "deny",
        "delegate_task": "deny"
      }
    },
    "gemini-analyst": {
      "description": "Large-context analysis and verification on Gemini 3.1 Pro Preview.",
      "model": "google-vertex/gemini-3.1-pro-preview",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "webfetch": "allow",
        "bash": "deny",
        "edit": "deny",
        "write": "deny",
        "task": "deny",
        "delegate_task": "deny"
      }
